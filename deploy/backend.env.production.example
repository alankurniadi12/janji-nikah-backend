NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://janji_nikah_app:<mongodb-app-password>@127.0.0.1:27017/janji-nikah?authSource=janji-nikah

APP_URL=https://janjinikah.com
API_URL=https://api.janjinikah.com
CLIENT_URLS=https://janjinikah.com,https://www.janjinikah.com

JWT_SECRET=<generate-with-openssl-rand-base64-48>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=<generate-with-openssl-rand-base64-48>

GOOGLE_CLIENT_ID=<production-google-client-id>
GOOGLE_CLIENT_SECRET=<production-google-client-secret>
GOOGLE_CALLBACK_URL=https://api.janjinikah.com/api/auth/google/callback

UPLOAD_DIR=/var/www/janji-nikah/uploads
MAX_IMAGE_SIZE_MB=5
MAX_AUDIO_SIZE_MB=10
IMAGE_MAX_WIDTH=1600
IMAGE_QUALITY=85
CLEANUP_INTERVAL_MS=21600000

ADMIN_EMAIL=<admin-email>
ADMIN_NAME=Admin Janji Nikah
